generator client {
  provider = "prisma-client-js"
  output   = "../../apps/api/generated/network"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_NETWORK")
}

model SectionMeta {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String?
  createdAt DateTime @default(now())

  @@map("_section_meta")
}

/// ملاحظة اختيارية على منفذ شبكة
model InterfaceNote {
  id        String   @id @default(uuid()) @db.Uuid
  ifName    String   @unique
  label     String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("interface_notes")
}
