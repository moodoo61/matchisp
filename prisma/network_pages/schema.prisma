generator client {
  provider = "prisma-client-js"
  output   = "../../apps/api/generated/network_pages"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_NETWORK_PAGES")
}

/// إعلان صورة — صفحة تسجيل الدخول
model ImageAd {
  id        String   @id @default(uuid()) @db.Uuid
  name      String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("advertisements")
}

/// ميزة بصرية — قائمة الميزات + صورة خلفية عند التمرير (صفحة الدخول)
model LoginFeature {
  id        String   @id @default(uuid()) @db.Uuid
  /// نص الميزة المعروض
  title     String
  /// أيقونة اختيارية (إيموجي أو نص قصير)
  icon      String   @default("")
  /// صورة الخلفية عند تمرير الماوس على الميزة
  imageUrl  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("login_features")
}

/// إعلان نص / شريط — صفحة تسجيل الدخول
model TextAd {
  id        String   @id @default(uuid()) @db.Uuid
  text      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("news_tickers")
}

/// أرقام التواصل القديمة — يُستبدل بـ ContactMethod (يُبقى للتوافق)
model LoginContacts {
  id          String   @id @default("default")
  adminPhone  String   @default("")
  repairPhone String   @default("")
  updatedAt   DateTime @updatedAt

  @@map("login_contacts")
}

/// طريقة تواصل — صفحة تسجيل الدخول (متوافق مع سكربت العميل)
model ContactMethod {
  id          String   @id @default(uuid()) @db.Uuid
  /// phone | whatsapp | email | facebook | tiktok | twitter | instagram | youtube | other
  contactType String
  /// العنوان الظاهر للعميل (contact_type_display)
  displayName String
  value       String
  notes       String   @default("")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("contact_methods")
}

/// خدمة سريعة — صفحة تسجيل الدخول (الاسم + الصورة + الرابط)
model LoginService {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  imageUrl  String
  linkUrl   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("login_services")
}

/// خدمة / زر — صفحة الحالة (الاسم + الصورة + الرابط)
model StatusService {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  imageUrl  String
  linkUrl   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("status_services")
}

/// باقة اشتراك — صفحة تسجيل الدخول
model LoginPackage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  price     Decimal  @db.Decimal(10, 2)
  time      String
  download  String
  validity  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("packages")
}

/// خيار سرعة — يُرسل كـ domain لـ MikroTik (نمط siteConfig.speedOptions)
/// «كروت هوتسبوت» (value فارغ) تبقى ثابتة في صفحة الراوتر وليست هنا
model SpeedOption {
  id        String   @id @default(uuid()) @db.Uuid
  /// النص المعروض للمستخدم
  name      String
  /// قيمة profile/domain في الراوتر (مثل 1M/3M أو open)
  value     String
  /// الخيار الافتراضي عند فتح صفحة الدخول
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("speed_options")
}

/// مفتاح تفعيل/تعطيل لكل بطاقة محتوى (بدون مسح عناصرها)
model PageCardFlag {
  key       String   @id
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("page_card_flags")
}

/// إعدادات أمان تسجيل الدخول — حظر المحاولات الفاشلة (Hot Blocker)
/// الحظر نفسه يبقى على كوكي المتصفح؛ هذه القيم تُضبط من السيرفر فقط
model LoginSecuritySettings {
  id           String   @id @default("default")
  /// تفعيل حظر المحاولات الفاشلة على صفحة الدخول
  enabled      Boolean  @default(true)
  /// عدد المحاولات الفاشلة قبل الحظر
  tryCount     Int      @default(10)
  /// مدة الحظر بالدقائق
  blockMinutes Int      @default(2)
  updatedAt    DateTime @updatedAt

  @@map("login_security_settings")
}

/// مصادقة خارجية — «الدخول كمشترك» عبر بوابة/تحقق ثم عودة لـ /login على الراوتر
model LoginExternalAuthSettings {
  id              String   @id @default("default")
  /// تفعيل الميزة
  enabled         Boolean  @default(false)
  /// credentials = إظهار حقول ثم تحقق | redirect = توجيه فوري للرابط
  flowMode        String   @default("credentials")
  /// عنوان بوابة ويب (لنمط redirect فقط)
  remoteUrl       String   @default("")
  /// طريقة الإرسال لنمط redirect: post | get
  httpMethod      String   @default("post")
  /// أصل RouterOS REST (مثل http://host:1616) لنمط credentials
  restBaseUrl     String   @default("")
  /// مستخدم API على CHR
  restUsername    String   @default("")
  /// كلمة مرور API على CHR
  restPassword    String   @default("")
  /// نص رابط «الدخول كمشترك» على الصفحة
  linkLabel       String   @default("الدخول كمشترك")
  /// حقول MikroTik المُرسلة (نمط redirect)
  sendMac         Boolean  @default(true)
  sendIp          Boolean  @default(true)
  sendUsername    Boolean  @default(true)
  sendLinkLogin   Boolean  @default(true)
  sendLinkOrig    Boolean  @default(true)
  sendError       Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@map("login_external_auth_settings")
}

/// علامة صفحة الدخول — افتراضياً من الإعدادات العامة، مع خيار تخصيص مستقل
model LoginBrandSettings {
  id        String   @id @default("default")
  /// true = استخدام name/logoUrl لهذه الصفحة بدل علامة الإعدادات العامة
  useCustom Boolean  @default(false)
  /// اسم مخصص (يُستخدم عند useCustom)
  name      String   @default("")
  /// شعار مخصص (يُستخدم عند useCustom)
  logoUrl   String   @default("")
  updatedAt DateTime @updatedAt

  @@map("login_brand_settings")
}

/// إعدادات صفحة المزيد العامة (singleton)
model MorePageSettings {
  id                     String   @id @default("default")
  heroTitle              String   @default("خدماتنا")
  heroSubtitle           String   @default("حلول إنترنت متقدمة وخدمات شاملة")
  itemsSectionTitle      String   @default("خدماتنا")
  itemsSectionSubtitle   String   @default("نقدم مجموعة واسعة من الخدمات لتلبية احتياجاتك")
  aboutSectionTitle      String   @default("من نحن")
  aboutSectionSubtitle   String   @default("تعرف على رؤيتنا ومهمتنا وقيمنا")
  storySectionTitle      String   @default("قصة ماتش لينك")
  storySectionSubtitle   String   @default("حكاية ماتش لينك: حين يتحوّل التعب إلى اتصال")
  footerText             String   @default("خدمات متاحة")
  updatedAt              DateTime @updatedAt

  @@map("more_page_settings")
}

/// بطاقة محتوى — تبويب العناصر في صفحة المزيد
model MorePageItem {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  imageUrl     String
  description  String
  /// خطوات التعليمات (مصفوفة نصوص) — اختياري
  instructions Json?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("more_page_items")
}

/// بطاقة «من نحن» — صفحة المزيد
model MorePageAboutCard {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  body      String
  /// vision | mission | values | custom
  iconKey   String   @default("custom")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("more_page_about_cards")
}

/// مقطع قصة — صفحة المزيد
model MorePageStoryBlock {
  id        String   @id @default(uuid()) @db.Uuid
  title     String?
  body      String
  imageUrl  String
  /// intro | section | highlight | conclusion
  variant   String   @default("section")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("more_page_story_blocks")
}
