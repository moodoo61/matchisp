generator client {
  provider = "prisma-client-js"
  output   = "../../apps/api/generated/magazine"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_MAGAZINE")
}

model SectionMeta {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String?
  createdAt DateTime @default(now())

  @@map("_section_meta")
}
