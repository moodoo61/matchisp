# Core — الوصول عن بُعد: ضع IP/نطاق هذا الجهاز (ليس عنوان خادم آخر)
HOST=0.0.0.0
API_PORT=3001
ADMIN_WEB_PORT=4010
ADMIN_WEB_URL=http://127.0.0.1:4010
API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
CORS_ORIGINS=*
# مضيفات إضافية لـ Next dev (IP LAN/VPN) — مفصولة بفاصلة، بدون منفذ إن أمكن
# مثال: ALLOWED_DEV_ORIGINS=172.18.1.2,192.168.1.10
ALLOWED_DEV_ORIGINS=
# مؤقت — true أو CORS_ORIGINS=* يسمح بأي Origin (أوقفه في الإنتاج)
CORS_ALLOW_ALL=true
API_INTERNAL_URL=http://127.0.0.1:3001

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seed admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME="مدير النظام"

# Databases (one Postgres server, many databases)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=isp
POSTGRES_PASSWORD=isp_secret
DATABASE_URL_CORE=postgresql://isp:isp_secret@localhost:5432/db_core?schema=public
DATABASE_URL_NETWORK_PAGES=postgresql://isp:isp_secret@localhost:5432/db_network_pages?schema=public
DATABASE_URL_LIVE=postgresql://isp:isp_secret@localhost:5432/db_live?schema=public
DATABASE_URL_BREAK=postgresql://isp:isp_secret@localhost:5432/db_break?schema=public
DATABASE_URL_COMMS=postgresql://isp:isp_secret@localhost:5432/db_comms?schema=public
DATABASE_URL_MAGAZINE=postgresql://isp:isp_secret@localhost:5432/db_magazine?schema=public
DATABASE_URL_MAINTENANCE=postgresql://isp:isp_secret@localhost:5432/db_maintenance?schema=public
DATABASE_URL_PARTNERS=postgresql://isp:isp_secret@localhost:5432/db_partners?schema=public
DATABASE_URL_INVENTORY=postgresql://isp:isp_secret@localhost:5432/db_inventory?schema=public
DATABASE_URL_ORDERS=postgresql://isp:isp_secret@localhost:5432/db_orders?schema=public
DATABASE_URL_SUPPORT=postgresql://isp:isp_secret@localhost:5432/db_support?schema=public
DATABASE_URL_EXPENSES=postgresql://isp:isp_secret@localhost:5432/db_expenses?schema=public
DATABASE_URL_PLATFORM=postgresql://isp:isp_secret@localhost:5432/db_platform?schema=public
DATABASE_URL_SERVICE_MONITOR=postgresql://isp:isp_secret@localhost:5432/db_service_monitor?schema=public
DATABASE_URL_SETTINGS=postgresql://isp:isp_secret@localhost:5432/db_settings?schema=public
DATABASE_URL_NETWORK=postgresql://isp:isp_secret@localhost:5432/db_network?schema=public

# مجلد حفظ نسخ قواعد الأقسام (pg_dump -Fc)
DATABASE_BACKUP_DIR=/opt/match/var/backups/databases

# MistServer (خادم البث المباشر)
MISTSERVER_API_URL=http://127.0.0.1:4242/api2
# عنوان HTTP لمشاهدة البث من المتصفح:
#   auto = استنتاج من مضيف الصفحة/الطلب (مناسب عند نسخ المشروع لجهاز آخر)
#   أو ضع عنواناً صريحاً إن كان Mist على مضيف مختلف: http://IP أو http://domain
MISTSERVER_HTTP_URL=auto
MISTSERVER_ENABLED=true

# LibreNMS / Asterisk (مراقب الخدمات — عناوين افتراضية إن لم تُضبط في الواجهة)
LIBRENMS_URL=http://127.0.0.1:8000
ASTERISK_AMI_URL=http://127.0.0.1:8088

# سكربت ترميز GPU + ملف إعدادات الجودة
LIVE_ABR_SCRIPT_PATH=/opt/match/scripts/live/abr_nvenc.sh
LIVE_ABR_CONFIG_PATH=/opt/match/var/live/abr_nvenc.json
LIVE_ABR_PROFILES_DIR=/opt/match/var/live/abr/profiles
# سكربت التمرير عبر ffmpeg
LIVE_FFPASS_SCRIPT=/opt/match/scripts/live/ffpass.sh

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=isp-files
